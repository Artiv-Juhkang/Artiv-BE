# 로컬 개발용 환경변수 예시. 복사해서 .env 로 만들고 값 채우기 (.env 는 커밋 금지).
# IntelliJ Run/Debug Configurations 의 Environment variables 에도 동일하게 넣을 수 있다.

# DB 접속 (docker-compose 의 db 서비스와 일치해야 함)
DB_USER=artiv
DB_PASSWORD=devpass
DB_URL=jdbc:postgresql://localhost:5432/artiv

# JWT 서명 키 — HS256 기준 최소 32바이트(256bit) 이상의 임의 문자열.
# 생성 예: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-at-least-32-bytes-long
